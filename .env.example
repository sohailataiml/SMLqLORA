# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# The pipeline reads these lazily: a component only demands the credential it
# actually needs, so the offline targets (make test, make eval-smoke,
# make smoke-data, make train-dry) work with this file absent entirely.

# --- Frontier providers -----------------------------------------------------
# Anthropic. Used as: a prompt-ceiling subject model, the LLM judge, and the
# teacher for data generation. Judge + teacher are the expensive roles.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI. Used as the second model family in the prompt-ceiling ablation. The
# spec requires >= 2 families, so without this the ablation is PROVISIONAL.
OPENAI_API_KEY=sk-...

# --- Hugging Face -----------------------------------------------------------
# Only needed to download gated base models or to push a trained adapter.
# HF_TOKEN=hf_...

# --- Optional overrides -----------------------------------------------------
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com/v1
